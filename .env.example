# Intake webhook security (required for /v1/intake)
INTAKE_WEBHOOK_SECRET=replace-with-a-long-random-string

# Email delivery via Resend (https://resend.com)
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM=Open Calls <noreply@yourdomain.com>
ADMIN_EMAIL=you@yourdomain.com

# Optional pipeline tuning
DATA_DIR=data/seed
INTAKE_TOP_K=5
REFERENCE_DATE=2026-03-29
OPENAI_API_KEY=

# API server
PORT=8000
